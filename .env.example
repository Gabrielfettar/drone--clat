# URL publique du site (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.droneeclat.fr
# Envoi des demandes de devis par e-mail via Resend (https://resend.com). Sans clé, l'API répond 503 en production.
RESEND_API_KEY=
LEAD_FROM_EMAIL="Drone Éclat <devis@droneeclat.fr>"
LEAD_TO_EMAIL=
# Mesure d'audience respectueuse (optionnel) : domaine déclaré dans Plausible. Vide = aucun script chargé.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
